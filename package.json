{
  "name": "muster-town",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "dev": "MUSTER_TOWN_DEV=1 npx tsx watch packages/server/src/main.ts",
    "start": "npm run build && npm run start:climate",
    "start:climate": "scripts/serve.sh collectives/climate",
    "start:workshop": "scripts/serve.sh collectives/workshop",
    "desk:build": "docker build -t muster-town-desk -t agent-town-desk -f packages/desk/Dockerfile ."
  },
  "engines": {
    "node": ">=20"
  }
}
