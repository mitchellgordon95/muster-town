{
  "name": "muster-town",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "check:docs": "tsx scripts/check-doc-refs.ts",
    "check:deadcode": "knip --include files,dependencies,unlisted,binaries --no-progress",
    "test": "npm run test -ws --if-present",
    "dev": "MUSTER_TOWN_DEV=1 npx tsx watch packages/server/src/main.ts",
    "start": "npm run build && npm run start:workshop",
    "start:workshop": "scripts/serve.sh collectives/workshop",
    "start:collective": "scripts/serve.sh",
    "desk:build": "docker build -t muster-town-desk -t agent-town-desk -f packages/desk/Dockerfile ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@muster-town/core": "*",
    "@muster-town/schema": "*",
    "knip": "^5.88.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
