{
  "name": "agent-town",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "dev": "npx tsx watch packages/server/src/main.ts",
    "start": "npm run build && npm run start:climate",
    "start:climate": "AGENT_TOWN_COLLECTIVE=collectives/climate npx tsx packages/server/src/main.ts",
    "start:workshop": "AGENT_TOWN_COLLECTIVE=collectives/workshop npx tsx packages/server/src/main.ts",
    "desk:build": "docker build -t agent-town-desk -f packages/desk/Dockerfile ."
  },
  "engines": {
    "node": ">=20"
  }
}
